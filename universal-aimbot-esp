table.insert(Connections, RunService.Heartbeat:Connect(function()
    pcall(function()
        if not scriptRunning then return end
        Camera = Workspace.CurrentCamera
        if not Camera then return end

        if not (Toggles.ESPEnable and Toggles.ESPEnable.Value == true) then
            hideAllESP()
            return
        end

        local maxDist = (Options.ESPMaxDist and Options.ESPMaxDist.Value) or 2500
        local camPos = Camera.CFrame.Position
        local vp = Camera.ViewportSize

        for _, player in ipairs(Players:GetPlayers()) do
            if player == LocalPlayer then continue end
            local char = player.Character
            if not char then
                hidePlayerESP(player)
                continue
            end
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hum or not hrp or hum.Health <= 0 then
                hidePlayerESP(player)
                continue
            end

            if Toggles.ESPTeamCheck and Toggles.ESPTeamCheck.Value == true then
                if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
                    hidePlayerESP(player)
                    continue
                end
            end

            local dist = (hrp.Position - camPos).Magnitude
            if dist > maxDist then
                hidePlayerESP(player)
                continue
            end

            local okBB, cf, size
            okBB = pcall(function()
                cf, size = char:GetBoundingBox()
            end)
            if not okBB or not cf or not size then
                hidePlayerESP(player)
                continue
            end

            local topWorld = cf.Position + Vector3.new(0, size.Y / 2, 0)
            local botWorld = cf.Position - Vector3.new(0, size.Y / 2, 0)
            local topScreen, topOn = Camera:WorldToViewportPoint(topWorld)
            local botScreen, botOn = Camera:WorldToViewportPoint(botWorld)

            local onScreen = topOn or botOn
            if not onScreen then
                hidePlayerESP(player)
                continue
            end

            local boxHeight = math.abs(botScreen.Y - topScreen.Y)
            if boxHeight < 1 then boxHeight = 1 end
            local boxWidth = boxHeight / 2
            local boxX = topScreen.X - boxWidth / 2
            local boxY = topScreen.Y

            local boxDraw = getDrawing(player, "Box")
            if boxDraw then
                if Toggles.ESPBox and Toggles.ESPBox.Value == true then
                    pcall(function()
                        boxDraw.Position = Vector2.new(boxX, boxY)
                        boxDraw.Size = Vector2.new(boxWidth, boxHeight)
                        boxDraw.Color = (Options.ESPBoxColor and Options.ESPBoxColor.Value) or Color3.new(1,1,1)
                        boxDraw.Thickness = 1
                        boxDraw.Filled = false
                        boxDraw.Visible = true
                    end)
                else
                    pcall(function() boxDraw.Visible = false end)
                end
            end

            local nameDraw = getDrawing(player, "Name")
            if nameDraw then
                if Toggles.ESPName and Toggles.ESPName.Value == true then
                    pcall(function()
                        nameDraw.Text = player.DisplayName
                        nameDraw.Position = Vector2.new(topScreen.X, boxY - 15)
                        nameDraw.Color = (Options.ESPNameColor and Options.ESPNameColor.Value) or Color3.new(1,1,1)
                        nameDraw.Center = true
                        nameDraw.Outline = true
                        nameDraw.Size = 13
                        nameDraw.Visible = true
                    end)
                else
                    pcall(function() nameDraw.Visible = false end)
                end
            end

            local hBar = getDrawing(player, "HealthBar")
            local hFill = getDrawing(player, "HealthFill")
            if Toggles.ESPHealth and Toggles.ESPHealth.Value == true then
                local hp = 0
                if hum.MaxHealth > 0 then
                    hp = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                end
                if hBar then
                    pcall(function()
                        hBar.From = Vector2.new(boxX - 6, boxY)
                        hBar.To = Vector2.new(boxX - 6, boxY + boxHeight)
                        hBar.Color = Color3.new(0, 0, 0)
                        hBar.Thickness = 3
                        hBar.Visible = true
                    end)
                end
                if hFill then
                    pcall(function()
                        hFill.From = Vector2.new(boxX - 6, boxY + boxHeight * (1 - hp))
                        hFill.To = Vector2.new(boxX - 6, boxY + boxHeight)
                        hFill.Color = Color3.new(1 - hp, hp, 0)
                        hFill.Thickness = 1
                        hFill.Visible = true
                    end)
                end
            else
                if hBar then pcall(function() hBar.Visible = false end) end
                if hFill then pcall(function() hFill.Visible = false end) end
            end

            local distDraw = getDrawing(player, "Dist")
            if distDraw then
                if Toggles.ESPDist and Toggles.ESPDist.Value == true then
                    pcall(function()
                        distDraw.Text = math.floor(dist) .. "m"
                        distDraw.Position = Vector2.new(topScreen.X, boxY + boxHeight + 5)
                        distDraw.Center = true
                        distDraw.Outline = true
                        distDraw.Size = 12
                        distDraw.Color = Color3.new(1, 1, 1)
                        distDraw.Visible = true
                    end)
                else
                    pcall(function() distDraw.Visible = false end)
                end
            end

            local tracerDraw = getDrawing(player, "Tracer")
            if tracerDraw then
                if Toggles.ESPTracer and Toggles.ESPTracer.Value == true then
                    pcall(function()
                        local screenCenter = Vector2.new(vp.X / 2, vp.Y)
                        local targetPos = Vector2.new(botScreen.X, botScreen.Y)
                        targetPos = Vector2.new(
                            math.clamp(targetPos.X, 10, vp.X - 10),
                            math.clamp(targetPos.Y, 10, vp.Y - 10)
                        )
                        tracerDraw.From = screenCenter
                        tracerDraw.To = targetPos
                        tracerDraw.Color = (Options.ESPTracerColor and Options.ESPTracerColor.Value) or Color3.new(1,1,1)
                        tracerDraw.Thickness = 1
                        tracerDraw.Visible = true
                    end)
                else
                    pcall(function() tracerDraw.Visible = false end)
                end
            end

            local dotDraw = getDrawing(player, "Dot")
            if dotDraw then
                if Toggles.ESPDot and Toggles.ESPDot.Value == true then
                    local head = char:FindFirstChild("Head")
                    if head then
                        local hPos, hOn = Camera:WorldToViewportPoint(head.Position)
                        if hOn then
                            pcall(function()
                                dotDraw.Position = Vector2.new(hPos.X, hPos.Y)
                                dotDraw.Radius = (Options.ESPDotSize and Options.ESPDotSize.Value) or 3
                                dotDraw.Filled = true
                                dotDraw.NumSides = 20
                                dotDraw.Thickness = 1
                                dotDraw.Color = (Options.ESPDotColor and Options.ESPDotColor.Value) or Color3.new(1,1,0)
                                dotDraw.Visible = true
                            end)
                        else
                            pcall(function() dotDraw.Visible = false end)
                        end
                    else
                        pcall(function() dotDraw.Visible = false end)
                    end
                else
                    pcall(function() dotDraw.Visible = false end)
                end
            end

            if Toggles.ESPSkeleton and Toggles.ESPSkeleton.Value == true then
                local isR15 = char:FindFirstChild("UpperTorso") ~= nil
                local bones = isR15 and SkeletonBones or SkeletonBonesR6
                local skelColor = (Options.ESPSkeletonColor and Options.ESPSkeletonColor.Value) or Color3.new(1,1,1)

                for i, bone in ipairs(bones) do
                    local line = getDrawing(player, "Skel_" .. i)
                    if line then
                        local partA = char:FindFirstChild(bone[1])
                        local partB = char:FindFirstChild(bone[2])
                        if partA and partB then
                            local spA, onA = Camera:WorldToViewportPoint(partA.Position)
                            local spB, onB = Camera:WorldToViewportPoint(partB.Position)
                            if onA and onB then
                                pcall(function()
                                    line.From = Vector2.new(spA.X, spA.Y)
                                    line.To = Vector2.new(spB.X, spB.Y)
                                    line.Color = skelColor
                                    line.Thickness = 1
                                    line.Visible = true
                                end)
                            else
                                pcall(function() line.Visible = false end)
                            end
                        else
                            pcall(function() line.Visible = false end)
                        end
                    end
                end

                local maxBones = math.max(#SkeletonBones, #SkeletonBonesR6)
                for i = #bones + 1, maxBones do
                    local line = getDrawing(player, "Skel_" .. i)
                    if line then pcall(function() line.Visible = false end) end
                end
            else
                local maxBones = math.max(#SkeletonBones, #SkeletonBonesR6)
                for i = 1, maxBones do
                    local line = getDrawing(player, "Skel_" .. i)
                    if line then pcall(function() line.Visible = false end) end
                end
            end

            if Toggles.ESP3D and Toggles.ESP3D.Value == true then
                local half = size / 2 + Vector3.new(0.2, 0.2, 0.2)
                local corners = {
                    cf * CFrame.new(-half.X, -half.Y, -half.Z),
                    cf * CFrame.new( half.X, -half.Y, -half.Z),
                    cf * CFrame.new( half.X,  half.Y, -half.Z),
                    cf * CFrame.new(-half.X,  half.Y, -half.Z),
                    cf * CFrame.new(-half.X, -half.Y,  half.Z),
                    cf * CFrame.new( half.X, -half.Y,  half.Z),
                    cf * CFrame.new( half.X,  half.Y,  half.Z),
                    cf * CFrame.new(-half.X,  half.Y,  half.Z),
                }
                local screenCorners = {}
                local allBehind = true
                for i, c in ipairs(corners) do
                    local sp, _ = Camera:WorldToViewportPoint(c.Position)
                    screenCorners[i] = Vector2.new(sp.X, sp.Y)
                    if sp.Z > 0 then allBehind = false end
                end
                local edgeList = {{1,2},{2,3},{3,4},{4,1},{5,6},{6,7},{7,8},{8,5},{1,5},{2,6},{3,7},{4,8}}
                if not allBehind then
                    for i, edge in ipairs(edgeList) do
                        local line = getDrawing(player, "3D_" .. i)
                        if line then
                            pcall(function()
                                line.From = screenCorners[edge[1]]
                                line.To = screenCorners[edge[2]]
                                line.Color = (Options.ESP3DColor and Options.ESP3DColor.Value) or Color3.fromRGB(0,255,255)
                                line.Thickness = 1
                                line.Visible = true
                            end)
                        end
                    end
                else
                    for i = 1, 12 do
                        local line = getDrawing(player, "3D_" .. i)
                        if line then pcall(function() line.Visible = false end) end
                    end
                end
            else
                for i = 1, 12 do
                    local line = getDrawing(player, "3D_" .. i)
                    if line then pcall(function() line.Visible = false end) end
                end
            end
        end
    end)
end))

