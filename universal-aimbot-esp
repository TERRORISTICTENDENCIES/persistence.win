table.insert(Connections, RunService.Heartbeat:Connect(function()
    pcall(function()
        if not scriptRunning then return end
        Camera = Workspace.CurrentCamera
        if not Camera then return end
        local lpChar = LocalPlayer.Character
        if not lpChar then return end

        local enabled = Toggles.TrigEnable and Toggles.TrigEnable.Value == true
        local keyOn = false
        if Options.TrigKey then
            local s1, r1 = pcall(function() return Options.TrigKey:GetState() end)
            if s1 then keyOn = r1 == true end
        end
        if not (enabled and keyOn) then return end

        local originRay
        if Options.TrigOrigin and Options.TrigOrigin.Value == "Mouse" then
            local m = UIS:GetMouseLocation()
            originRay = Camera:ViewportPointToRay(m.X, m.Y)
        else
            local c = Camera.ViewportSize / 2
            originRay = Camera:ViewportPointToRay(c.X, c.Y)
        end

        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {lpChar, Camera}

        local result = Workspace:Raycast(originRay.Origin, originRay.Direction * 1000, params)
        if not result or not result.Instance then return end

        local hitChar = result.Instance:FindFirstAncestorOfClass("Model")
        if not hitChar then return end
        local hitPlayer = Players:GetPlayerFromCharacter(hitChar)
        if not hitPlayer or hitPlayer == LocalPlayer then return end

        local hum = hitChar:FindFirstChildOfClass("Humanoid")
        if not hum then return end

        if Toggles.TrigAliveCheck and Toggles.TrigAliveCheck.Value == true then
            if hum.Health <= 0 then return end
        end

        if Toggles.TrigTeamCheck and Toggles.TrigTeamCheck.Value == true then
            if hitPlayer.Team and LocalPlayer.Team and hitPlayer.Team == LocalPlayer.Team then return end
        end

        local hasWL, allowed = isWhitelistedOnly(hitPlayer)
        if hasWL and not allowed then return end
        if isBlacklisted(hitPlayer) then return end

        local delayMs = (Options.TrigDelay and Options.TrigDelay.Value) or 0
        task.delay(delayMs / 1000, function()
            pcall(function()
                if mouse1click then mouse1click() end
            end)
            if tick() - lastTrigNotify > 1 then
                safeNotify("Triggerbot fired!", 1)
                lastTrigNotify = tick()
            end
        end)
    end)
end))

