local function getDrawing(player, key)
    if not DrawingEnabled or not player then return nil end
    local uid = player.UserId
    if not ESPDrawings[uid] then
        ESPDrawings[uid] = {}
    end
    if ESPDrawings[uid][key] then
        return ESPDrawings[uid][key]
    end

    local d
    if key == "Box" then
        d = newDrawing("Square", {
            Thickness = 1,
            Filled = false,
            Transparency = 1,
            Color = Color3.new(1,1,1),
            Visible = false
        })
    elseif key == "Name" then
        d = newDrawing("Text", {
            Size = 13,
            Center = true,
            Outline = true,
            Font = 2,
            Color = Color3.new(1,1,1),
            Visible = false
        })
    elseif key == "Dist" then
        d = newDrawing("Text", {
            Size = 12,
            Center = true,
            Outline = true,
            Font = 2,
            Color = Color3.new(1,1,1),
            Visible = false
        })
    elseif key == "HealthBar" then
        d = newDrawing("Line", {
            Thickness = 3,
            Color = Color3.new(0,0,0),
            Visible = false
        })
    elseif key == "HealthFill" then
        d = newDrawing("Line", {
            Thickness = 1,
            Color = Color3.new(0,1,0),
            Visible = false
        })
    elseif key == "Tracer" then
        d = newDrawing("Line", {
            Thickness = 1,
            Color = Color3.new(1,1,1),
            Visible = false
        })
    elseif key == "Dot" then
        d = newDrawing("Circle", {
            Thickness = 1,
            NumSides = 20,
            Filled = true,
            Radius = 3,
            Color = Color3.new(1,1,0),
            Visible = false
        })
    elseif key:sub(1, 5) == "Skel_" then
        d = newDrawing("Line", {
            Thickness = 1,
            Color = Color3.new(1,1,1),
            Visible = false
        })
    elseif key:sub(1, 3) == "3D_" then
        d = newDrawing("Line", {
            Thickness = 1,
            Color = Color3.fromRGB(0,255,255),
            Visible = false
        })
    end

    if d then
        ESPDrawings[uid][key] = d
    end
    return d
end

local function hidePlayerESP(player)
    if not player then return end
    local uid = player.UserId
    if ESPDrawings[uid] then
        for _, d in pairs(ESPDrawings[uid]) do
            pcall(function() d.Visible = false end)
        end
    end
end

local function hideAllESP()
    for _, playerDrawings in pairs(ESPDrawings) do
        for _, d in pairs(playerDrawings) do
            pcall(function() d.Visible = false end)
        end
    end
end

