function refreshPlayerLists()
    pcall(function()
        local values = {'None'}
        playerIdMap = {}

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local key = p.DisplayName .. ' (' .. p.Name .. ')'
                table.insert(values, key)
                playerIdMap[key] = p.UserId
            end
        end

        if Options.Whitelist then
            pcall(function() Options.Whitelist:SetValues(values) end)
        end
        if Options.Blacklist then
            pcall(function() Options.Blacklist:SetValues(values) end)
        end
    end)
end

