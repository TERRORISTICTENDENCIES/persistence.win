local function newDrawing(kind, props)
    if not DrawingEnabled then return nil end
    local d
    local success = pcall(function()
        d = Drawing.new(kind)
        if props then
            for k, v in pairs(props) do
                d[k] = v
            end
        end
    end)
    if success and d then
        table.insert(AllDrawings, d)
        return d
    end
    return nil
end

