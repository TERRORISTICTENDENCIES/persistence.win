-- AIMBOT HELPERS
--============================================================
local function getTargetPart(char, mode)
    if not char then return nil end
    if mode == "Head" then
        return char:FindFirstChild("Head")
    elseif mode == "HumanoidRootPart" then
        return char:FindFirstChild("HumanoidRootPart")
    elseif mode == "Torso" then
        return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
    elseif mode == "Closest" then
        local parts = {"Head", "UpperTorso", "Torso", "HumanoidRootPart", "LowerTorso",
                        "LeftUpperArm", "RightUpperArm", "LeftUpperLeg", "RightUpperLeg"}
        local closestPart = nil
        local closestDist = math.huge
        local origin2
        if Options.AimFOVOrigin and Options.AimFOVOrigin.Value == "Mouse" then
            origin2 = UIS:GetMouseLocation()
        else
            origin2 = Camera.ViewportSize / 2
        end
        for _, pn in ipairs(parts) do
            local p = char:FindFirstChild(pn)
            if p then
                local sp, on = Camera:WorldToViewportPoint(p.Position)
                if on then
                    local d = (Vector2.new(sp.X, sp.Y) - origin2).Magnitude
                    if d < closestDist then
                        closestDist = d
                        closestPart = p
                    end
                end
            end
        end
        return closestPart or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
    end
    return char:FindFirstChild("Head")
end

local function isWhitelistedOnly(player)
    if not Options.Whitelist then return false, true end
    local val
    pcall(function() val = Options.Whitelist.Value end)
    if not val or val == "None" or val == "" then
        return false, true
    end
    local uid = playerIdMap[val]
    if not uid then return false, true end
    return true, (player.UserId == uid)
end

local function isBlacklisted(player)
    if not Options.Blacklist then return false end
    local val
    pcall(function() val = Options.Blacklist.Value end)
    if not val or val == "None" or val == "" then
        return false
    end
    local uid = playerIdMap[val]
    if not uid then return false end
    return player.UserId == uid
end

local aimRaycastParams = RaycastParams.new()
aimRaycastParams.FilterType = Enum.RaycastFilterType.Exclude

--============================================================
-- AIMBOT RENDER LOOP
--============================================================
table.insert(Connections, RunService.RenderStepped:Connect(function()
    pcall(function()
        if not scriptRunning then return end
        Camera = Workspace.CurrentCamera
        if not Camera then return end
        local lpChar = LocalPlayer.Character
        if not lpChar then
            if TargetLine then pcall(function() TargetLine.Visible = false end) end
            if FOVCircle then pcall(function() FOVCircle.Visible = false end) end
            currentTarget = nil
            return
        end

        local enabled = Toggles.AimEnable and Toggles.AimEnable.Value == true

        local keyOn = false
        if Options.AimKey then
            local s1, r1 = pcall(function() return Options.AimKey:GetState() end)
            if s1 then keyOn = r1 == true end
        end

        local origin
        if Options.AimFOVOrigin and Options.AimFOVOrigin.Value == "Mouse" then
            origin = UIS:GetMouseLocation()
        else
            origin = Camera.ViewportSize / 2
        end

        local fovRadius = (Options.AimFOV and Options.AimFOV.Value) or 150

        if FOVCircle then
            local showFOV = Toggles.AimShowFOV and Toggles.AimShowFOV.Value == true
            pcall(function()
                FOVCircle.Visible = enabled and showFOV
                if FOVCircle.Visible then
                    FOVCircle.Position = origin
                    FOVCircle.Radius = fovRadius
                    FOVCircle.Color = (Options.AimFOVColor and Options.AimFOVColor.Value) or Color3.new(1,1,1)
                    FOVCircle.Thickness = 1
                    FOVCircle.Filled = false
                    FOVCircle.NumSides = 60
                end
            end)
        end

        if not enabled then
            currentTarget = nil
            if TargetLine then pcall(function() TargetLine.Visible = false end) end
            return
        end

        local aimRange = (Options.AimRange and Options.AimRange.Value) or 2500
        local aimPartMode = (Options.AimPart and Options.AimPart.Value) or "Head"

        pcall(function()
            aimRaycastParams.FilterDescendantsInstances = {lpChar, Camera}
        end)

        local bestTarget = nil
        local bestDist = fovRadius

        for _, player in ipairs(Players:GetPlayers()) do
            if player == LocalPlayer then continue end
            local char = player.Character
            if not char then continue end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then continue end

            if Toggles.AimTeamCheck and Toggles.AimTeamCheck.Value == true then
                if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then continue end
            end

            local hasWL, allowed = isWhitelistedOnly(player)
            if hasWL and not allowed then continue end
            if isBlacklisted(player) then continue end

            local part = getTargetPart(char, aimPartMode)
            if not part then continue end

            local dist3D = (part.Position - Camera.CFrame.Position).Magnitude
            if dist3D > aimRange then continue end

            if Toggles.AimWallCheck and Toggles.AimWallCheck.Value == true then
                local rayOrigin = Camera.CFrame.Position
                local rayDir = (part.Position - rayOrigin)
                local result = Workspace:Raycast(rayOrigin, rayDir, aimRaycastParams)
                if result and result.Instance and not result.Instance:IsDescendantOf(char) then
                    continue
                end
            end

            local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if not onScreen then continue end

            local dist2D = (Vector2.new(screenPos.X, screenPos.Y) - origin).Magnitude
            if dist2D < bestDist then
                bestDist = dist2D
                bestTarget = part
            end
        end

        -- Target line always draws to closest in-FOV player when aimbot enabled
        if TargetLine then
            if Toggles.AimTargetLine and Toggles.AimTargetLine.Value == true and bestTarget and bestTarget.Parent then
                pcall(function()
                    local center = Camera.ViewportSize / 2
                    local sp, onS = Camera:WorldToViewportPoint(bestTarget.Position)
                    if onS then
                        TargetLine.From = center
                        TargetLine.To = Vector2.new(sp.X, sp.Y)
                        TargetLine.Color = (Options.AimLineColor and Options.AimLineColor.Value) or Color3.new(1,0,0)
                        TargetLine.Thickness = 1
                        TargetLine.Visible = true
                    else
                        TargetLine.Visible = false
                    end
                end)
            else
                pcall(function() TargetLine.Visible = false end)
            end
        end

        if not keyOn then
            currentTarget = nil
            return
        end

        if bestTarget ~= currentTarget then
            if bestTarget then
                local tp = Players:GetPlayerFromCharacter(bestTarget.Parent)
                if tp then
                    safeNotify("Locked: " .. tp.DisplayName, 1.5)
                end
            end
            currentTarget = bestTarget
        end

        if currentTarget then
            local valid = false
            pcall(function()
                if currentTarget.Parent and currentTarget.Parent:FindFirstChildOfClass("Humanoid") then
                    local h = currentTarget.Parent:FindFirstChildOfClass("Humanoid")
                    if h.Health > 0 then valid = true end
                end
            end)
            if not valid then currentTarget = nil end
        end

        if currentTarget and currentTarget.Parent then
            local targetCF = CFrame.new(Camera.CFrame.Position, currentTarget.Position)
            local smoothVal = (Options.AimSmooth and Options.AimSmooth.Value) or 20
            smoothVal = math.clamp(smoothVal, 1, 100)
            local lerpFactor = math.clamp(1 / smoothVal, 0.005, 1)
            Camera.CFrame = Camera.CFrame:Lerp(targetCF, lerpFactor)
        end
    end)
end))

